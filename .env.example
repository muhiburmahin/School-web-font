# Browser calls /api/v1 on the school's own domain; src/app/api/v1/[...path]/route.ts forwards it to the backend.
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Where the NestJS API listens (server side only). Required.
BACKEND_ORIGIN=http://localhost:5000
# Shared secret that lets this app tell the backend which school a request is for.
# Must equal TRUSTED_PROXY_SECRET on the backend. At least 32 random characters. Never expose to the browser.
TRUSTED_PROXY_SECRET=
SESSION_COOKIE_NAME=sid
NEXT_PUBLIC_CSRF_COOKIE_NAME=csrf
NEXT_PUBLIC_CSRF_HEADER=x-csrf-token
NEXT_PUBLIC_API_MOCKS=false
CSP_REPORT_ONLY=false
MEDIA_IMAGE_ORIGINS=
